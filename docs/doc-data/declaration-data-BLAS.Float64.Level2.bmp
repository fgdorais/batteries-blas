Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">v</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float.html#Float\">Float</a></div></div>","info":{"doc":"The value of `gemv` at the index `i` of `y`, from its old value `v`, on the arrays, with the\nspecial cases of the reference BLAS: `v` when `n = 0`, and `betaMul β v` when `α = 0`.","docLink":"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvAt","kind":"def","line":41,"name":"BLAS.Float64.Mat.gemvAt","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float64/Level2.lean#L41-L47"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvSumAt\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float64</span>.<span class=\"name\">Mat</span>.<span class=\"name\">gemvSumAt</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">m </span><span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Mat.html#BLAS.Float64.Mat\">Mat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Vec.html#BLAS.Float64.Vec\">Vec</a> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float.html#Floa