rArray.Stride.idx\">idx</a></span> <span class=\"fn\">0</span> <span class=\"fn\">n</span> <span class=\"fn\">(<a href=\"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvTSumAt\">gemvTSumAt</a> <span class=\"fn\">α</span> <span class=\"fn\">A</span> <span class=\"fn\">x</span> <span class=\"fn\">β</span>)</span></span></div></div>","info":{"doc":"","docLink":"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvTData_eq","kind":"theorem","line":517,"name":"BLAS.Float64.Mat.gemvTData_eq","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float64/Level2.lean#L517-L534"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvTData\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float64</span>.<span class=\"name\">Mat</span>.<span class=\"name\">gemvTData</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">m </span><span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Mat.html#BLAS.Float64.Mat\">Mat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Vec.html#BLAS.Float64.Vec\">Vec</a> <span class=\"fn\">m</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">y</span> : <span class=\"fn\"><a href=\".