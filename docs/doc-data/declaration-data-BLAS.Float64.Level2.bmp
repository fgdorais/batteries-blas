relude.html#USize.size\">USize.size</a> <a href=\"./Init/Prelude.html#And\">∧</a> <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">x</span>.<a href=\"./BLAS/Float64/Vec.html#BLAS.Float64.Vec.data\">data</a></span>.<a href=\"./ScalarArray/Float64/Basic.html#ScalarArray.Float64Array.size\">size</a></span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <a href=\"./Init/Prelude.html#USize.size\">USize.size</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hn</span> : <span class=\"fn\">n</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <a href=\"./Init/Prelude.html#USize.size\">USize.size</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">mu</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hmu</span> : <span class=\"fn\"><span class=\"fn\">mu</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\">m</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">j</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hj</span> : <span class=\"fn\"><span class=\"fn\">j</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\">3</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\">n</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">acc</span> : <a href=\"./ScalarArray/Float64/Basic.html#ScalarArray.Float64Array\">ScalarArray.Float64Array</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">i</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s₀ </span><span class=\"fn\">s₁ </span><span class=\"fn\">s₂ </span><span class=\"fn\">s₃</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./ScalarArray/Float64/Basic.html#ScalarArray.Float64Array\">ScalarArray.Float64Array</a></div></div>","info":{"doc":"The loop of `gemvTSums4` from the index `i`, up to the bound `mu`, which is `m`: the sums `s₀`,\n`s₁`, `s₂` and `s₃` of the columns `j` to `j + 3`, so far. At the end, it pushes them onto `acc`.\nThe four sums are independent, so that their additions overlap, and they share the reads of `x`.","docLink":"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvTSums4","kind":"def","line":340,"name":"BLAS.Float64.Mat.gemvTSums4","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float64/Level2.lean#L340-L363"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvTSum\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float64</span>.<span class=\"name\">Mat</span>.<span class=\"name\">gemvTSum</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">m </span><span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Mat.html#BLAS.Float64.Mat\">Mat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Vec.html#BLAS.Float64.Vec\">Vec</a> <span class=\"fn\">m</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">j</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float.html#Float\">Float</a></div></div>","info":{"doc":"The sum of the products `A[i, j] * x[i]` of column `j` of `A` and `x`, from the left.","docLink":"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvTSum","kind":"def","line":336,"name":"BLAS.Float64.Mat.gemvTSum","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float64/Level2.lean#L336-L338"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvTAt\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float64</span>.<span class=\"name\">Mat</span>.<span class=\"name\">gemvTAt</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">m </span><span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Mat.html#BLAS.Float64.Mat\">Mat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Vec.html#BLAS.Float64.Vec\">Vec</a> <span class=\"fn\">m</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">j</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">v</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float.html#Float\">Float</a></div></div>","info":{"doc":"The value of `gemvT` at the index `j` of `y`, from its old value `v`, on the arrays, with the\nspecial cases of the reference BLAS: `v` when `m = 0`, and `betaMul β v` when `α = 0`.","docLink":"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvTAt","kind":"def","line":328,"name":"BLAS.Float64.Mat.gemvTAt","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float64/Level2.lean#L328-L334"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float64/Level2.html#BLAS.Float64.Mat.gemvTSumAt\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float64</span>.<span class=\"name\">Mat</span>.<span class=\"name\">gemvTSumAt</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">m </span><span class=\"fn\">n</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Mat.html#BLAS.Float64.Mat\">Mat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">x</span> : <span class=\"fn\"><a href=\"./BLAS/Float64/Vec.html#BLAS.Float64.Vec\">Vec</a> <span class=\"fn\">m</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float.html#Float\">Float</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">j</span> : <a href=\"./Init/Pr