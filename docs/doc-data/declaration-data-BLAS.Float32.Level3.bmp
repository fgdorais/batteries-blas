n\" href=\"./BLAS/Float32/Level3.html#BLAS.Float32.PMat.gemm\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">PMat</span>.<span class=\"name\">gemm</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">m </span><span class=\"fn\">n </span><span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">m</span> <span class=\"fn\">k</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">B</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">k</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span></div></div>","info":{"doc":"`gemm α A B β C` is `α * A * B + β * C`, by the naive loops of the reference BLAS: for each column\n`j`, it scales the column of `C` by `β`, or sets it to `0` without reading it when `β = 0`, then\nadds `α * B[l, j]` times column `l` of `A`, for `l = 0, …, k - 1`. It updates `C` in place when\n`C` is not shared. `Mat.gemmNaive` handles the case `α = 0`, which doesn't run this kernel.","docLink":"./BLAS/Float32/Level3.html#BLAS.Float32.PMat.gemm","kind":"def","line":53,"name":"BLAS.Float32.PMat.gemm","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Level3.lean#L53-L94"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Level3.html#BLAS.Float32.PMat.gemmModel\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">PMat</span>.<span class=\"name\">gemmModel</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">m </span><span class=\"fn\">n </span><span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">m</span> <span class=\"fn\">k</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">B</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">k</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span></div></div>","info":{"doc":"The model of `gemm`, with `gemmEntry` at each element.","docLink":"./BLAS/Float32/Level3.html#BLAS.Float32.PMat.gemmModel","kind":"def","line":48,"name":"BLAS.Float32.PMat.gemmModel","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Level3.lean#L48-L51"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Level3.html#BLAS.Float32.PMat.gemmEntry\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">PMat</span>.<span class=\"name\">gemmEntry</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">m </span><span class=\"fn\">n </span><span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">m</span> <span class=\"fn\">k</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">B</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">k</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/PMat.html#BLAS.Float32.PMat\">PMat</a> <span class=\"fn\">m</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">i </span><span class=\"fn\">j</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hi</span> : <span class=\"fn\">i</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\">m</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hj</span> : <span class=\"fn\">j</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\">n</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></div></div>","info":{"doc":"The value of `gemm α A B β C` at `(i, j)`: `betaMul β C[i, j]`, plus the terms\n`α * B[l, j] * A[i, l]` for `l = 0, …, k - 1`, added from the left, in the order of the reference\nBLAS.","docLink":"./BLAS/Float32/Level3.html#BLAS.Float32.PMat.gemmEntry","kind":"def","line":39,"name":"BLAS.Float32.PMat.gemmEntry","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Level3.lean#L39-L46"}}],"imports":["BLAS.Float32.Loop","BLAS.Float32.PMat","BLAS.Internal","Init","ScalarArray.Notation"],"instances":[],"name":"BLAS.Float32.Level3"}