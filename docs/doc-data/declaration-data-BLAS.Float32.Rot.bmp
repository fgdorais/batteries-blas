2.Vec\">Vec</a> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./ScalarArray/Float32/Basic.html#ScalarArray.Float32Array\">ScalarArray.Float32Array</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./ScalarArray/Float32/Basic.html#ScalarArray.Float32Array\">ScalarArray.Float32Array</a></div></div>","info":{"doc":"`zip f g x y` writes `f x[i] y[i]` over `x[i]` and `g x[i] y[i]` over `y[i]`, for each `i`, in\nplace when the arrays of `x` and `y` are not shared. Both values come from the old elements. It is\nscalar-arrays' `zipModifyStride`, which checks each array once and then stores without checks.","docLink":"./BLAS/Float32/Rot.html#BLAS.Float32.Vec.zipData","kind":"def","line":28,"name":"BLAS.Float32.Vec.zipData","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Rot.lean#L28-L35"}}],"imports":["BLAS.Float32.Level1","Init"],"instances":[{"className":"Inhabited","name":"BLAS.Float32.instInhabitedRotmParam","typeNames":["BLAS.Float32.RotmParam"]},{"className":"Repr","name":"BLAS.Float32.instReprRotmParam","typeNames":["BLAS.Float32.RotmParam"]},{"className":"Inhabited","name":"BLAS.Float32.instInhabitedRotg","typeNames":["BLAS.Float32.Rotg"]},{"className":"Repr","name":"BLAS.Float32.instReprRotg","typeNames":["BLAS.Float32.Rotg"]},{"className":"Inhabited","name":"BLAS.Float32.instInhabitedRotmg","typeNames":["BLAS.Float32.Rotmg"]},{"className":"Repr","name":"BLAS.Float32.instReprRotmg","typeNames":["BLAS.Float32.Rotmg"]}],"name":"BLAS.Float32.Rot"}