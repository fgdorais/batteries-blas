\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">Mat</span>.<span class=\"name\">syrkRest1</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">lo1 </span><span class=\"fn\">hi0</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s0</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#USize\">USize</a></div></div>","info":{"doc":"The start of the rows of column `j + 1` that the separate loop of `syrkCol2Data` updates.","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkRest1","kind":"def","line":310,"name":"BLAS.Float32.Mat.syrkRest1","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Syrk.lean#L310-L312"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkRest0\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">Mat</span>.<span class=\"name\">syrkRest0</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">lo0 </span><span class=\"fn\">lo1 </span><span class=\"fn\">hi0</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s0 </span><span class=\"fn\">s1</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#USize\">USize</a></div></div>","info":{"doc":"The end of the rows of column `j` that the separate loop of `syrkCol2Data` updates.","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkRest0","kind":"def","line":306,"name":"BLAS.Float32.Mat.syrkRest0","sourceLink":"https://