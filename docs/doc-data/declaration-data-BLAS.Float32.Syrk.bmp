AS/Float32/Trsv.html#BLAS.Float32.Uplo\">Uplo</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">k</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">j</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hj</span> : <span class=\"fn\">j</span> <a href=\"./Init/Prelude.html#HAdd.hAdd\">+</a> <span class=\"fn\">1</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\">n</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkCol2Data\">syrkCol2Data</a> <span class=\"fn\">uplo</span> <span class=\"fn\">α</span> <span class=\"fn\">A</span> <span class=\"fn\">β</span> <span class=\"fn\">C</span> <span class=\"fn\">j</span> <span class=\"fn\">hj</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a>   <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.mapMat\">mapMat</a> <span class=\"fn\"><span class=\"fn\">C</span>.<a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat.data\">data</a></span> <span class=\"fn\"><span class=\"fn\">C</span>.<a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat.off\">off</a></span> <span class=\"