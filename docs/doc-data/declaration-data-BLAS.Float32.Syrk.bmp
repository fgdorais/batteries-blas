n\">j</span> <span class=\"fn\">v</span></span></span></span></div></div>","info":{"doc":"","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkColData_eq","kind":"theorem","line":164,"name":"BLAS.Float32.Mat.syrkColData_eq","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Syrk.lean#L164-L224"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkColData\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">Mat</span>.<span class=\"name\">syrkColData</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">n </span><span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">uplo</span> : <a href=\"./BLAS/Float32/Trsv.html#BLAS.Float32.Uplo\">Uplo</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">k</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">j</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">hj</span> : <span class=\"fn\">j</span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\">n</span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./ScalarArray/Float32/Basic.html#ScalarArray.Float32Array\">ScalarArray.Float32Array</a></div></div>","info":{"doc":"The array of `C` with column `j` of `syrk` done: the triangle's part of the column scaled by `β`,\nthen the terms of `α * A[j, l]` times column `l` of `A` added to it, for `l = 0, …, k - 1`. The\ncolumns run in a separate function, not in a third nested loop, so that the C compiler turns the\nloops into jumps instead of calls, which would use stack for each term.","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkColData","kind":"def","line":121,"name":"BLAS.Float32.Mat.syrkColData","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Syrk.lean#L121-L162"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkRows_le\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">Mat</span>.<span class=\"name\">syrkRows_le</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">lo </span><span class=\"fn\">hi</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">h</span> : <span class=\"fn\"><span class=\"fn\">lo</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#LE.le\">≤</a> <span class=\"fn\"><span class=\"fn\">hi</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">skip</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">(<a href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkRows\">syrkRows</a> <span class=\"fn\">lo</span> <span class=\"fn\">hi</span> <span class=\"fn\">skip</span>)</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#LE.le\">≤</a> <span class=\"fn\"><span class=\"fn\">hi</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span></div></div>","info":{"doc":"","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkRows_le","kind":"theorem","line":117,"name":"BLAS.Float32.Mat.syrkRows_le","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Syrk.lean#L117-L119"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkRows\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">Mat</span>.<span class=\"name\">syrkRows</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">lo </span><span class=\"fn\">hi</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">skip</span> : <a href=\"./Init/Prelude.html#Bool\">Bool</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#USize\">USize</a></div></div>","info":{"doc":"The row after the last that the loop of `syrk` updates for the term `l` of a column: `lo`, so that\nthe loop is empty, when the term is skipped. It is not inlined, as `Uplo.loU`.","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkRows","kind":"def","line":110,"name":"BLAS.Float32.Mat.syrkRows","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Syrk.lean#L110-L115"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkAt\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">Mat</span>.<span class=\"name\">syrkAt</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">n </span><span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">uplo</span> : <a href=\"./BLAS/Float32/Trsv.html#BLAS.Float32.Uplo\">Uplo</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">k</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">i </span><span class=\"fn\">j</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">v</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a></div></div>","info":{"doc":"`syrkSumAt` in the triangle `uplo`, and the old value elsewhere.","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkAt","kind":"def","line":105,"name":"BLAS.Float32.Mat.syrkAt","sourceLink":"https://github.com/fgdorais/lean4-blas/