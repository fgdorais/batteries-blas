\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">k</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><span class=\"fn\">(<a href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrk\">syrk</a> <span class=\"fn\">uplo</span> <span class=\"fn\">α</span> <span class=\"fn\">A</span> <span class=\"fn\">β</span> <span class=\"fn\">C</span>)</span>.<a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat.data\">data</a></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.mapMat\">mapMat</a> <span class=\"fn\"><span class=\"fn\">C</span>.<a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat.data\">data</a></span> <span class=\"fn\"><span class=\"fn\">C</span>.<a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat.off\">off</a></span> <span class=\"fn\"><span class=\"fn\">C</span>.<a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat.ld\">ld</a></span> <span class=\"fn\">n</span> <span class=\"fn\">0</span> <span class=\"fn\">n</span> <span class=\"fn\">(<a href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkAt\">syrkAt</a> <span class=\"fn\">uplo</span> <span class=\"fn\">α</span> <span class=\"fn\">A</span> <span class=\"fn\">β</span>)</span></span></div></div>","info":{"doc":"The array of `syrk uplo α A β C` is the array of `C` with its triangle updated.","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.data_syrk","kind":"theorem","line":616,"name":"BLAS.Float32.Mat.data_syrk","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Syrk.lean#L616-L619"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrk\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">Mat</span>.<span class=\"name\">syrk</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">n </span><span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">uplo</span> : <a href=\"./BLAS/Float32/Trsv.html#BLAS.Float32.Uplo\">Uplo</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">k</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">n</span></span></div></div>","info":{"doc":"`syrk uplo α A β C` is `α * A * Aᵀ + β * C`, on the triangle `uplo` of `C`, by the loops of the\nreference BLAS: for each column `j`, it scales the triangle's part of the column by `β`, or sets it\nto `0` without reading it when `β = 0`, then adds `α * A[j, l]` times column `l` of `A` to it, for\n`l = 0, …, k - 1`. As in the reference BLAS, it skips the terms with `A[j, l] = 0`, so that an\ninfinity or a `NaN` in `A` doesn't reach them, and only scales `C` when `α = 0`. It updates `C` in\nplace when its array is not shared, and leaves the elements of the array outside the triangle\nunchanged.","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrk","kind":"def","line":599,"name":"BLAS.Float32.Mat.syrk","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Syrk.lean#L599-L614"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkData_eq\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">Mat</span>.<span class=\"name\">syrkData_eq</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">n </span><span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#Nat\">Nat</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">uplo</span> : <a href=\"./BLAS/Float32/Trsv.html#BLAS.Float32.Uplo\">Uplo</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">α</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">A</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">k</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">β</span> : <a href=\"./Init/Data/Float/Float32.html#Float32\">Float32</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">C</span> : <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat\">Mat</a> <span class=\"fn\">n</span> <span class=\"fn\">n</span></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkData\">syrkData</a> <span class=\"fn\">uplo</span> <span class=\"fn\">α</span> <span class=\"fn\">A</span> <span class=\"fn\">β</span> <span class=\"fn\">C</span></span> <a href=\"./Init/Prelude.html#Eq\">=</a> <span class=\"fn\"><a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.mapMat\">mapMat</a> <span class=\"fn\"><span class=\"fn\">C</span>.<a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat.data\">data</a></span> <span class=\"fn\"><span class=\"fn\">C</span>.<a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat.off\">off</a></span> <span class=\"fn\"><span class=\"fn\">C</span>.<a href=\"./BLAS/Float32/Mat.html#BLAS.Float32.Mat.ld\">ld</a></span> <span class=\"fn\">n</span> <span class=\"fn\">0</span> <span class=\"fn\">n</span> <span class=\"fn\">(<a href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkAt\">syrkAt</a> <span class=\"fn\">uplo</span> <span class=\"fn\">α</span> <span class=\"fn\">A</span> <span class=\"fn\">β</span>)</span></span></div></div>","info":{"doc":"","docLink":"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkData_eq","kind":"theorem","line":595,"name":"BLAS.Float32.Mat.syrkData_eq","sourceLink":"https://github.com/fgdorais/lean4-blas/blob/0b5b806802a404d62a8c76bf36594f35690cd2ba/BLAS/Float32/Syrk.lean#L595-L597"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./BLAS/Float32/Syrk.html#BLAS.Float32.Mat.syrkData\"><span class=\"name\">BLAS</span>.<span class=\"name\">Float32</span>.<span class=\"name\">Mat</span>.<span class=\"name\">syrkData</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><s